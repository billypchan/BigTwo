# Xcode
*.xcuserstate
xcuserdata/
*.xccheckout
*.moved-aside
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
*.xcbkptlist

# Swift Package Manager
.build/
.swiftpm/
BigTwoKit/.build/
BigTwoKit/.swiftpm/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/*.html
fastlane/test_output

# OS
.DS_Store
/build
__pycache__/
*.pyc

# Claude harness runtime
.claude/*.lock
.claude/settings.local.json

# App Store Connect API private keys — never commit these
*.p8
private_keys/

# Archives and exports
*.xcarchive

# TestFlight「測試重點」— generated per build by ci_scripts/ci_post_xcodebuild.sh
# (it carries that build's commit hash, so a committed copy would always be stale)
/TestFlight/
